# Build stage
FROM node:20-alpine AS builder

WORKDIR /tt-admin

# Copy package files
COPY ./admin/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY ./admin .

# Build arguments
ARG VITE_APP_ADMIN_NAME
ARG VITE_APP_SERVER_URL
ARG VITE_APP_ADMIN_URL
ENV VITE_APP_ADMIN_NAME=${VITE_APP_ADMIN_NAME}
ENV VITE_APP_SERVER_URL=${VITE_APP_SERVER_URL}
ENV VITE_APP_ADMIN_URL=${VITE_APP_ADMIN_URL}

# Build the application
RUN npm run build

# Production stage - use nginx for smaller image
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /tt-admin/dist /usr/share/nginx/html

# Copy nginx configuration (optional - nginx default works for SPA)
RUN echo 'server { \
    listen 3001; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
    try_files $uri $uri/ /index.html; \
    } \
    }' > /etc/nginx/conf.d/default.conf

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
