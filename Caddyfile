api.example.com {
  reverse_proxy server:5000 {
    header_down Strict-Transport-Security max-age=31536000;
  }
}

example.com, www.example.com {
  reverse_proxy client:3000 {
    header_down Strict-Transport-Security max-age=31536000;
  }
   handle /api/* {
    reverse_proxy server:5000
  }
}

admin.example.com {
    reverse_proxy admin:3001 {
      header_down Strict-Transport-Security max-age=31536000;
    }

  handle /api/* {
    reverse_proxy server:5000
  }
}
